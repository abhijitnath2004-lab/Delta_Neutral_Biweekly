{
  "capital": 1000000,

  "lot_size": 65,
  "num_lots": 1,

  "target_delta": 0.20,
  "delta_tolerance": 0.02,
  "max_delta_threshold": 0.35,
  "hedge_distance_points": 200,
  "delta_imbalance_ratio": 2.0,
  "premium_decay_pct": 50.0,

  "min_net_credit_pct": 3.5,
  "target_profit_pct": 1.0,
  "stop_loss_pct": 1.0,

  "vix_threshold": 14.0,

  "entry_day": "Wednesday",
  "entry_time": "15:00",
  "exit_day": "Friday",
  "exit_time": "15:00",
  "max_holding_sessions": 8,

  "expiry_offset_weeks": 2,

  "underlying_symbol": "NIFTY",
  "underlying_instrument_key": "NSE_INDEX|Nifty 50",
  "vix_instrument_key": "NSE_INDEX|India VIX",
  "exchange": "NFO",
  "product": "D",

  "strike_step": 100,
  "min_delta_floor": 0.10,
  "premium_balance_tolerance_pct": 5.0,
  "tick_size": 0.05,

  "limit_max_attempts": 5,
  "limit_wait_seconds": 60,
  "limit_fallback_to_market": true,
  "market_max_attempts": 3,
  "market_wait_seconds": 10,
  "verify_position_before_close": true,

  "upstox": {
    "base_url_v2": "https://api.upstox.com/v2",
    "base_url_v3": "https://api.upstox.com/v3",
    "access_token_env": "UPSTOX_ACCESS_TOKEN",
    "endpoints": {
      "option_chain":  {"version": "v2", "path": "/option/chain"},
      "market_quote":  {"version": "v2", "path": "/market-quote/quotes"},
      "ltp":           {"version": "v2", "path": "/market-quote/ltp"},
      "place_order":   {"version": "v3", "path": "/order/place"},
      "cancel_order":  {"version": "v3", "path": "/order/cancel"},
      "order_details": {"version": "v2", "path": "/order/details"},
      "positions":     {"version": "v2", "path": "/portfolio/short-term-positions"}
    },
    "fill_poll_attempts": 5,
    "fill_poll_delay_seconds": 1.0
  },

  "monitor_interval_minutes": 5,
  "monitor_window_start": "09:20",
  "monitor_window_end":   "15:25",
  "tick_buffer_seconds":  7,

  "state_file": "state/active_trade.json",
  "closed_trades_dir": "state/closed_trades",
  "log_file": "logs/strategy.log"
}
